# ─────────────────────────────────────────────
#  부업 계산기 환경변수 (.env 로 복사해서 사용)
# ─────────────────────────────────────────────

# 서버 포트
PORT=3000

# ── 구글 애드센스(AdSense) OAuth ──
# https://console.cloud.google.com 에서 OAuth 2.0 클라이언트 ID 발급 후 입력.
# AdSense Management API 를 사용 설정해야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 콜백 주소 (구글 콘솔의 '승인된 리디렉션 URI' 와 동일해야 함)
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── 네이버 애드포스트(AdPost) ──
# 공식 API가 없어 로그인 쿠키 기반으로 수집합니다.
# 보통 기본값으로 두면 되고, 네이버가 엔드포인트를 바꾸면 여기서 조정합니다.
ADPOST_REPORT_URL=https://adpost.naver.com/api/v3/report/total
